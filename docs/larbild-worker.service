# Install on Sibbis as /etc/systemd/system/larbild-worker.service
# (then: sudo systemctl daemon-reload && sudo systemctl enable --now larbild-worker.service)
# deploy-sibbis.sh restarts this unit each deploy; this file is the canonical
# template so a fresh clone/deploy can install it. The referenced
# /etc/larbild/render.env (Redis auth + ComfyUI target) is a host secret and is
# NOT committed.
[Unit]
Description=Larbild render worker — BRPOP loop, ComfyUI render on VM100 (SFW)
After=network-online.target larbild.service
Wants=network-online.target

[Service]
Type=simple
User=lektove
Group=lektove
WorkingDirectory=/home/lektove/larbild-app
# Redis (queue + GPU lock) + ComfyUI bridge target + SFW base checkpoint name.
EnvironmentFile=/etc/larbild/render.env
Environment=LARBILD_ENV=production
Environment=PYTHONPATH=/home/lektove/larbild-app
Environment=LARBILD_DB_PATH=/home/lektove/larbild-app/data/larbild.db
Environment=LARBILD_STORAGE=/mnt/vm153-output/larbild
Environment=LARBILD_SECRET_PATH=/home/lektove/.larbild-secret
# The worker SSHes Sibbis->VM100 for vram_pause GPU telemetry/eviction reads.
ExecStart=/home/lektove/larbild-app/venv/bin/python3 /home/lektove/larbild-app/scripts/run_render_worker.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
