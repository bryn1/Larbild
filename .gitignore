# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# SQLite / runtime data (never commit the DB or generated media)
*.db
*.db-shm
*.db-wal
/data/
/storage/
/output/
/results/

# SFW-only model dir (lb-83n, P0.4): checkpoints + LoRAs are large runtime
# assets sourced/curated in P9 (lb-0ul), never source. The dir is created on
# boot by app.storage.ensure_layout; its contents must never be committed.
/models/

# Node / frontend build intermediates (commit built static/, not node_modules)
node_modules/
frontend/node_modules/
frontend/dist/
.vite/

# Secrets / local config
.env
.env.*
*.local

# Logs
*.log
logs/

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Gas Town polecat worktree runtime — injected when a polecat works in its
# sandbox (agent context, lock/session state, local beads cache). Never part of
# the app; ignored so an auto-checkpoint can't commit them into the repo.
/CLAUDE.md
/.claude/
/.beads/
/.runtime/
